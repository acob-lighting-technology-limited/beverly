# Copy to .env for local work. Never commit real values.
NODE_ENV=development
PORT=8787
# Pooler URL for the beverly_call_api role (password set out of band in Supabase)
DATABASE_URL=postgres://beverly_call_api:CHANGE_ME@HOST:6543/postgres
BEVERLY_AUTH_URL=https://YOUR-PROJECT.supabase.co
BEVERLY_AUTH_ANON_KEY=CHANGE_ME
BEVERLY_API_URL=https://beverly.example.com
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_1234567890
SESSION_TTL_MINUTES=60
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Africa's Talking (the carrier). Get these from the AT dashboard (use username "sandbox" while testing).
AT_USERNAME=CHANGE_ME
AT_API_KEY=CHANGE_ME
AT_VIRTUAL_NUMBER=+234XXXXXXXXXX
# Secret AT sends back on every callback. Configure the voice callback as
#   <API_PUBLIC_URL>/api/webhooks/at/voice?secret=<AT_WEBHOOK_SECRET>
# and the incoming-SMS callback as <API_PUBLIC_URL>/api/webhooks/at/sms?secret=<AT_WEBHOOK_SECRET>
AT_WEBHOOK_SECRET=CHANGE_ME_16_CHARS_MIN
API_PUBLIC_URL=https://YOUR-API-HOST

# Recording storage in the shared Supabase project. The key is server-side only: never expose it to the browser or commit it.
RECORDINGS_STORAGE_URL=https://YOUR-PROJECT.supabase.co
RECORDINGS_STORAGE_KEY=CHANGE_ME
RECORDING_RETENTION_DAYS=90

# Web Push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:ops@example.com
LOGIN_RATE_LIMIT=8

# Reference only (kept in .env, not read by the API): project service role and database password
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
