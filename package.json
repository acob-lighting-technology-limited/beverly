{
  "name": "beverly-call",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @beverly-call/web dev",
    "dev:mock": "pnpm --filter @beverly-call/api dev:mock",
    "build": "pnpm --filter @beverly-call/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
