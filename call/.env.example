# Copy to .env for local work. Never commit real values.
NODE_ENV=development
PORT=8787
# Pooler URL for the beverly_call_api role (password set out of band in Supabase)
DATABASE_URL=postgres://beverly_call_api:CHANGE_ME@HOST:6543/postgres
BEVERLY_AUTH_URL=https://YOUR-PROJECT.supabase.co
BEVERLY_AUTH_ANON_KEY=CHANGE_ME
BEVERLY_API_URL=https://beverly.example.com
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_1234567890
SESSION_TTL_MINUTES=60
ALLOWED_ORIGIN=http://127.0.0.1:5173

# Africa's Talking voice webhook secret (16+ chars). Webhooks are refused when unset.
AT_WEBHOOK_SECRET=CHANGE_ME_16_CHARS_MIN
# Recording storage in the shared Supabase project: a key scoped to the recordings bucket only
RECORDINGS_STORAGE_URL=https://YOUR-PROJECT.supabase.co
RECORDINGS_STORAGE_KEY=CHANGE_ME
RECORDING_RETENTION_DAYS=90
